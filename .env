# OpenRide Frontend Environment Variables - PRODUCTION

# API Configuration
EXPO_PUBLIC_API_URL=https://openride-java.solivolt.live/api
EXPO_PUBLIC_SOCKET_URL=https://openride-java.solivolt.live
EXPO_PUBLIC_PYTHON_URL=https://openride-python.solivolt.live

# Google Maps API Key (REQUIRED)
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable: Maps SDK for Android, Maps SDK for iOS, Directions API, Places API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Interswitch Payment (optional - for payment processing)
#EXPO_PUBLIC_INTERSWITCH_MERCHANT_CODE=
#EXPO_PUBLIC_INTERSWITCH_PAY_ITEM_ID=

# Environment
EXPO_PUBLIC_ENV=production

# Sentry (optional - for error tracking)
EXPO_PUBLIC_SENTRY_DSN=

# App Configuration
EXPO_PUBLIC_APP_NAME=OpenRide
EXPO_PUBLIC_APP_VERSION=1.0.0
