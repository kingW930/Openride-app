# OpenRide Frontend Environment Variables

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# Google Maps API Key (required for maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Interswitch Payment (optional - for payment processing)
EXPO_PUBLIC_INTERSWITCH_MERCHANT_CODE=your_merchant_code
EXPO_PUBLIC_INTERSWITCH_PAY_ITEM_ID=your_pay_item_id

# Environment
EXPO_PUBLIC_ENV=development

# Sentry (optional - for error tracking)
EXPO_PUBLIC_SENTRY_DSN=

# App Configuration
EXPO_PUBLIC_APP_NAME=OpenRide
EXPO_PUBLIC_APP_VERSION=1.0.0
